{
  "rules": {
    "misa_actual": {
      ".read": true,
      ".write": "auth != null && auth.token.email_verified == true && root.child('admins').child(auth.token.email.toLowerCase().replace('.', ',')).val() == true",
      "$i": {
        ".validate": "newData.isString() && newData.val().length <= 80"
      }
    },
    "misa_meta": {
      ".read": true,
      ".write": "auth != null && auth.token.email_verified == true && root.child('admins').child(auth.token.email.toLowerCase().replace('.', ',')).val() == true",
      ".validate": "newData.hasChildren(['por', 'cuando'])",
      "por": {
        ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
      },
      "cuando": {
        ".validate": "newData.isNumber() && newData.val() <= now"
      },
      "$otro": {
        ".validate": false
      }
    },
    "notas": {
      ".read": true,
      "$id": {
        ".write": "auth != null && auth.token.email_verified == true && root.child('admins').child(auth.token.email.toLowerCase().replace('.', ',')).val() == true",
        ".validate": "newData.isString() && newData.val().length <= 500"
      }
    },
    "tonos": {
      ".read": true,
      "$id": {
        ".write": "auth != null && auth.token.email_verified == true && root.child('admins').child(auth.token.email.toLowerCase().replace('.', ',')).val() == true",
        ".validate": "newData.hasChildren(['transponer', 'capo'])",
        "transponer": {
          ".validate": "newData.isNumber() && newData.val() % 1 == 0 && newData.val() >= -11 && newData.val() <= 11"
        },
        "capo": {
          ".validate": "newData.isNumber() && newData.val() % 1 == 0 && newData.val() >= 0 && newData.val() <= 8"
        },
        "$otro": {
          ".validate": false
        }
      }
    },
    "admins": {
      "$email": {
        ".read": "auth != null && auth.token.email.toLowerCase().replace('.', ',') == $email"
      }
    }
  }
}
